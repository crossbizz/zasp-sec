# Operator CLI settings only. Merge into the private config of the actual
# deployment profile. Replace the sample bucket, account ID and paths.
ZASP_BACKUP_PROVIDER=r2
ZASP_BACKUP_BUCKET=example-pilot-backups
ZASP_BACKUP_R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
ZASP_BACKUP_CREDENTIALS_FILE=/etc/zasp/offsite/writer.credentials
ZASP_BACKUP_RECIPIENT_FILE=/etc/zasp/offsite/recovery-public.pem
