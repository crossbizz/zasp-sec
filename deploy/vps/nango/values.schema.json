{
  "$schema":"https://json-schema.org/draft-07/schema#",
  "type":"object",
  "additionalProperties":false,
  "required":["image","tlsProxyImage","publicOrigin","dashboard","storageSecret","serverTLSSecret","databaseCA","databaseEgressCIDRs","providerEgressCIDRs","clients"],
  "definitions":{
    "image":{"type":"string","pattern":"^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"},
    "name":{"type":"string","pattern":"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$","maxLength":63},
    "cidrs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-fA-F.:]+/[1-9][0-9]{0,2}$"}},
    "client":{"type":"object","additionalProperties":false,"required":["namespace","workloads"],"properties":{"namespace":{"$ref":"#/definitions/name"},"workloads":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/name"}}}}
  },
  "properties":{
    "image":{"$ref":"#/definitions/image"},"tlsProxyImage":{"$ref":"#/definitions/image"},
    "publicOrigin":{"type":"string","pattern":"^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
    "dashboard":{
      "type":"object","additionalProperties":false,"required":["hostname","allowSignup","clients","emailSecret","smtpEgressCIDRs"],
      "properties":{
        "hostname":{"type":"string","maxLength":253,"pattern":"^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"},
        "allowSignup":{"type":"boolean"},
        "clients":{"type":"array","items":{"$ref":"#/definitions/client"}},
        "emailSecret":{"oneOf":[{"const":""},{"$ref":"#/definitions/name"}]},
        "smtpEgressCIDRs":{"oneOf":[{"const":[]},{"$ref":"#/definitions/cidrs"}]}
      }
    },
    "storageSecret":{"$ref":"#/definitions/name"},"serverTLSSecret":{"$ref":"#/definitions/name"},"databaseCA":{"$ref":"#/definitions/name"},
    "databaseEgressCIDRs":{"$ref":"#/definitions/cidrs"},"providerEgressCIDRs":{"$ref":"#/definitions/cidrs"},
    "clients":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/client"}}
  }
}
