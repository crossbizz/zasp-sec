{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "tlsSecret", "storageClass", "storageSize", "clientNamespace", "clientPodLabels"],
  "properties": {
    "image": {"type":"string","pattern":"^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"},
    "tlsSecret": {"type":"string","minLength":1},
    "storageClass": {"type":"string"},
    "storageSize": {"type":"string","minLength":1},
    "clientNamespace": {"type":"string","minLength":1},
    "clientPodLabels": {"type":"object","minProperties":1,"additionalProperties":{"type":"string","minLength":1}}
  }
}
