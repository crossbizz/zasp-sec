# Zasp configuration: one file for ./zasp, whatever the profile.
#
#   ./zasp config init        copies this file to zasp.env in the repository root (private to you)
#   ./zasp doctor             tells you which of these settings are still missing
#
# Plain KEY=VALUE lines. Nothing is executed or expanded: write values
# literally. A variable set in your shell wins over this file. The file holds
# credentials: keep it private (chmod 600) and out of version control.
# Reference: docs/getting-started/administrator.md, "Keys, secrets and settings".

# Where Zasp runs: local (one machine), kubernetes (any cluster, one Helm
# chart, evaluation) or aws (production on EKS).
ZASP_PROFILE=local

# ---------------------------------------------------------------------------
# Every profile
# ---------------------------------------------------------------------------

# REQUIRED. The identity provider. Zasp signs people in through Stytch B2B, a
# hosted service: create a B2B project at https://stytch.com/ and copy the
# three values from its API keys page. Use a test project for evaluation.
STYTCH_PROJECT_ID=
STYTCH_SECRET=
STYTCH_PUBLIC_TOKEN=

# The first organization and its first administrator. './zasp up' creates
# them; the identity provider emails the administrator an invitation.
# Lower case domain and address.
ZASP_ORGANIZATION_NAME=
ZASP_ORGANIZATION_DOMAIN=
ZASP_ADMIN_EMAIL=

# Optional. Model provider key for the Security Agent planner (OpenRouter).
# Without it Security Agent runs stay queued; everything else works.
OPENROUTER_API_KEY=

# The OAuth provider returning members sign in with. It must be enabled in
# the Stytch project: google, microsoft, github, slack or hubspot.
ZASP_OAUTH_PROVIDER=google

# ---------------------------------------------------------------------------
# Profile local
# ---------------------------------------------------------------------------

# The address you open in the browser. HTTPS, and a host name that is not
# localhost, *.local or an IP address. './zasp doctor' prints the /etc/hosts
# line that maps it to this machine.
ZASP_ORIGIN=https://zasp.local-stack.test:8443

# docker: PostgreSQL, Temporal, OpenFGA, LocalStack, OpenSearch and Neo4j run
#         as containers. The full stack.
# native: no containers. PostgreSQL, OpenFGA, the Temporal development server
#         and moto run as local processes that you installed. A reduced
#         stack: no sync, search or graph.
ZASP_DEPENDENCIES=docker

# Where the local deployment keeps its keys, logs and programs.
# Default: ~/.local/state/zasp-real-stack
#ZASP_STATE_DIR=

# native only: the directory holding initdb and pg_ctl, and the data
# directory. As root the server runs as the system user 'postgres', which
# must be able to reach the data directory.
#ZASP_POSTGRES_BIN=/usr/lib/postgresql/18/bin
#ZASP_POSTGRES_DATA=/var/lib/zasp-real-stack/postgres

# ---------------------------------------------------------------------------
# Profile kubernetes (uses ZASP_ORIGIN and the settings under "Every profile")
# ---------------------------------------------------------------------------

# The private values file './zasp secrets init' writes and Helm installs from.
# Default: zasp-values.yaml in the repository root.
#ZASP_KUBE_VALUES=
#ZASP_KUBE_NAMESPACE=zasp
#ZASP_KUBE_RELEASE=zasp
# Default: the current kubectl context.
#ZASP_KUBE_CONTEXT=

# The three product images, if you built them yourself ...
#ZASP_IMAGE_API=registry.example.com/zasp/zasp-api:1
#ZASP_IMAGE_WORKER=registry.example.com/zasp/zasp-worker:1
#ZASP_IMAGE_WEB=registry.example.com/zasp/zasp-web:1
# ... or the registry './zasp install --build-images' pushes them to.
#ZASP_IMAGE_REGISTRY=registry.example.com/zasp

# https://test.stytch.com for a Stytch test project, https://api.stytch.com
# for a live one.
#ZASP_STYTCH_BASE_URL=https://test.stytch.com

# ---------------------------------------------------------------------------
# Profile aws (production; see docs/operations/production-aws-runbook.md)
# ---------------------------------------------------------------------------

#ZASP_AWS_REGION=us-west-2
#ZASP_AWS_ACCOUNT_ID=000000000000
#ZASP_AWS_CLUSTER=zasp-production
# The public host name of the product, without https://.
#ZASP_AWS_HOST=app.example.com
# Your copies of deploy/production/example.tfvars and
# deploy/production/values-production.example.yaml, kept outside the
# repository. './zasp config init --profile aws' does not create them;
# './zasp doctor' tells you how.
#ZASP_AWS_TFVARS=/secure/zasp-production.tfvars
#ZASP_AWS_VALUES=/secure/values-production.yaml
# A file holding the DSN of the zasp_operator database role (step 1 of the runbook).
#ZASP_AWS_OPERATOR_DSN_FILE=/secure/zasp-operator.dsn
# The host of the product database, as the service logins reach it.
#ZASP_AWS_DATABASE_HOST=db.example.com
# The OpenFGA store and model published in step 6 of the runbook.
#ZASP_AWS_OPENFGA_STORE_ID=
#ZASP_AWS_OPENFGA_MODEL_ID=
