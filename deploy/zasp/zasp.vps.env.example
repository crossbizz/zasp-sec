# New single-node x86_64 k3s installation. Read docs/operations/vps-first-deployment.md.
# Format is literal KEY=VALUE; no interpolation. Use absolute paths. Keep the generated
# config private. Leave private keys, bearer tokens and passwords in protected files.
# The independent services are installable. Full Zasp application startup is gated.

ZASP_PROFILE=vps
# REQUIRED for managed component operations. Bind this config to one reviewed cluster.
ZASP_VPS_KUBE_CONTEXT=
ZASP_VPS_CLUSTER_UID=
ZASP_VPS_INSTALLATION_ID=
ZASP_VPS_STORAGE_PATH=/var/lib/rancher/k3s
ZASP_VPS_STORAGE_CLASS=local-path
# REQUIRED for install dependencies. CNPG-compatible PostgreSQL 18 image, registry/repository@sha256:digest.
ZASP_VPS_POSTGRES_IMAGE=
# Optional offline mirror of the reviewed Temporal and OpenFGA chart archives.
#ZASP_VPS_RUNTIME_CHART_DIR=

# Separate deployments and scopes. "openbao" applies to connector credentials,
# not to all AWS secrets used by a complete production installation.
ZASP_CONNECTOR_SECRETS_PROVIDER=openbao
ZASP_RECOVERY_SIGNING_PROVIDER=openbao
ZASP_EVIDENCE_PROVIDER=s3
ZASP_EVIDENCE_ENCRYPTION=provider-managed
ZASP_QUEUE_PROVIDER=sqs
ZASP_AUDIT_EXPORT_QUEUE_ENCRYPTION=provider-managed
ZASP_BACKUP_PROVIDER=r2

# REQUIRED for complete public-origin and image preflight.
# Supply each registry/repository@sha256:digest from the same reviewed release.
ZASP_ORIGIN=
ZASP_IMAGE_API=
ZASP_IMAGE_WORKER=
ZASP_IMAGE_WEB=
# Optional owner-private containers-auth JSON for operator-side skopeo checks.
#ZASP_VPS_REGISTRY_AUTH_FILE=/etc/zasp/registry/auth.json

# Independent OpenBao and Nango units. In managed mode supply existing
# namespaces/TLS artifacts as documented and absolute, credential-free values files.
ZASP_VPS_OPENBAO_MODE=managed
ZASP_VPS_OPENBAO_NAMESPACE=openbao-system
ZASP_VPS_OPENBAO_VALUES_FILE=/etc/zasp/openbao-values.yaml
ZASP_VPS_OPENBAO_CA_FILE=/etc/zasp/trust/openbao-ca.pem
ZASP_VPS_OPENBAO_STATUS_TOKEN_FILE=/etc/zasp/openbao/status.token
ZASP_VPS_NANGO_MODE=managed
ZASP_VPS_NANGO_NAMESPACE=connectors
ZASP_VPS_NANGO_VALUES_FILE=/etc/zasp/nango-values.yaml
ZASP_VPS_NANGO_CA_FILE=/etc/zasp/trust/nango-ca.pem
ZASP_VPS_NANGO_SERVICE_KEY_FILE=/etc/zasp/nango/service-key
# Existing-service checks use the documented verified service authority.
#ZASP_VPS_OPENBAO_URL=
#ZASP_VPS_NANGO_URL=
# On the protected custodian workstation for first initialization only.
#ZASP_VPS_OPENBAO_PGP_KEYS_DIR=
#ZASP_VPS_OPENBAO_HANDOFF_FILE=

# REQUIRED for AWS metadata checks. Existing infrastructure resources are operator-provisioned.
# Use the 12-digit infrastructure AWS account ID, not a customer account ID.
ZASP_AWS_REGION=
ZASP_EVIDENCE_BUCKET=
ZASP_EVIDENCE_BUCKET_OWNER=
ZASP_DISCOVERY_QUEUE_URL=
ZASP_AUDIT_EXPORT_QUEUE_URL=
ZASP_VPS_AWS_DOCTOR_ROLE_ARN=
ZASP_VPS_AWS_DOCTOR_TOKEN_FILE=
# Optional additional queue to inspect. Specify its actual worker kind.
#ZASP_RECOVERY_QUEUE_URL=
#ZASP_RECOVERY_OPERATION_KIND=backup
# Retain a historical evidence KMS ARN only where the retained objects require it.
#ZASP_EVIDENCE_KMS_KEY_ARN=

# REQUIRED for an R2 backup. The account ID selects the native S3-compatible R2 endpoint. The writer
# credentials file and recipient certificate live outside this config.
ZASP_BACKUP_R2_ACCOUNT_ID=
ZASP_BACKUP_BUCKET=
ZASP_BACKUP_CREDENTIALS_FILE=/etc/zasp/offsite/writer.credentials
ZASP_BACKUP_RECIPIENT_FILE=/etc/zasp/offsite/recovery-public.pem
ZASP_VPS_BACKUP_SPEC_FILE=/etc/zasp/vps-backup.json
ZASP_VPS_BACKUP_RECEIPT_DIR=/mnt/recovery-inventory/zasp
ZASP_VPS_BACKUP_KEEP=7
# Set to the independently stored receipt from a successful recovery rehearsal.
ZASP_VPS_BACKUP_VERIFIED_RECEIPT=
# On the recovery host only. This directory must be new.
ZASP_VPS_RESTORE_DIRECTORY=/srv/zasp-recovery/new
#ZASP_BACKUP_IDENTITY_FILE=
#ZASP_BACKUP_PASSPHRASE_FILE=
