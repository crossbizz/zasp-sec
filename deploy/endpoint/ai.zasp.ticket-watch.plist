<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.zasp.ticket-watch</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/libexec/zasp-endpoint</string>
    <string>watch-ticket</string>
    <string>--managed-config</string><string>/Library/Application Support/Zasp/endpoint.json</string>
