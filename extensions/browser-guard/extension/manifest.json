{
  "manifest_version": 3,
  "name": "Zasp Browser Guard",
  "description": "Shows local daily app usage on the AI origins enabled by your browser administrator.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["storage", "scripting", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "storage": { "managed_schema": "managed-schema.json" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Zasp browser coverage", "default_popup": "status.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  }
}
