      "github-839011429"
    ],
    "setup": "#!/usr/bin/env bash\n# scripts/setup_yarn_corepack.sh\n# ------------------------------------------------------------\n# Sets up Node.js LTS, Corepack, and Yarn for a Codex workspace\n# ------------------------------------------------------------\nset -euo pipefail\n\necho \"🔍  Checking Node.js…\"\nif ! command -v node >/dev/null 2>&1; then\n  echo \"📦  Installing latest Node LTS…\"\n  curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash -\n  sudo apt-get install -y nodejs\nelse\n  echo \"✅  Found Node $(node -v)\"\nfi\n\necho \"🔧  Enabling Corepack (ships with Node ≥ 16.10)…\"\ncorepack enable\n\necho \"⬆️   Activating latest stable Yarn…\"\ncorepack prepare yarn@stable --activate\n\necho \"📂  Point Yarn’s global folder to ~/.yarn for easy caching\"\nyarn config set globalFolder \"${HOME}/.yarn\" --home\n\necho \"🧹  Cleaning npm cache (optional)\"\nnpm cache clean --force >/dev/null 2>&1 || true\n\necho \"🎉  Yarn $(yarn --version) is ready to use!\"\n",
    "maintenance_setup": null,
