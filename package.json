{
  "name": "zasp-agent-security-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build:repo": "node scripts/build-repo.mjs",
    "db:pool:test": "go test -C services/platform -race -count=1 ./database && go test -C proofs/neon-pooled -race -count=1 ./...",
    "db:pool:run": "node --env-file=.env proofs/neon-pooled/run-pool-wrapper.mjs",
    "db:schema:test": "go test -C services/platform -race -count=1 ./migrations && go test -C proofs/neon-pooled -race -count=1 ./...",
    "db:schema:run": "node --env-file=.env proofs/neon-pooled/run-schema-baseline.mjs",
    "dependencies:check": "node scripts/validate-dependencies.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "proof:neon:run": "cd proofs/neon-pooled && go run .",
    "proof:neon:test": "cd proofs/neon-pooled && go test -race ./...",
    "proof:neon:migration:run": "node --env-file=.env proofs/neon-pooled/run-migration.mjs",
    "proof:neon:migration:test": "cd proofs/neon-pooled && go test -race -count=1 ./...",
    "proof:localstack:sqs:test": "cd proofs/localstack-sqs && go test -race -count=1 ./...",
    "proof:localstack:sqs:run": "node --env-file=.env proofs/localstack-sqs/run.mjs",
    "proof:localstack:storage:test": "cd proofs/localstack-storage && go test -race -count=1 ./... && node --test run.test.mjs",
    "proof:localstack:storage:run": "node proofs/localstack-storage/run.mjs",
    "proof:opensearch:event:test": "cd proofs/opensearch-event && go test -race -count=1 ./... && node --test run.test.mjs",
    "proof:opensearch:event:run": "node proofs/opensearch-event/run.mjs",
    "proof:localstack:iam:test": "cd proofs/localstack-iam-compat && go test -race -count=1 ./... && node --test run.test.mjs",
    "proof:localstack:iam:run": "node proofs/localstack-iam-compat/run.mjs",
    "proof:cartography:test": "cd proofs/cartography-scope && node --test normalizer.test.mjs run.test.mjs && /opt/homebrew/bin/python3.13 -m unittest -v fixture_runner_test.py",
    "proof:cartography:run": "node proofs/cartography-scope/run.mjs",
    "proof:prowler:test": "cd proofs/prowler-evidence && node --test normalizer.test.mjs run.test.mjs license-audit.test.mjs && PYTHONDONTWRITEBYTECODE=1 /opt/homebrew/bin/python3.13 -m unittest -v fixture_runner_test.FixtureParsingTests fixture_runner_test.ArtifactBoundaryTests fixture_runner_test.RuntimeTests fixture_runner_test.FileBoundaryTests fixture_runner_test.MainBoundaryTests",
    "proof:prowler:run": "node proofs/prowler-evidence/run.mjs",
    "proof:prowler:license": "node proofs/prowler-evidence/license-audit.mjs",
    "proof:otlp:test": "node --test proofs/otlp-ingest/*.test.mjs",
    "proof:otlp:run": "node proofs/otlp-ingest/run.mjs",
    "proof:otlp-export:test": "node --test proofs/otlp-export/*.test.mjs",
    "proof:otlp-export:run": "node proofs/otlp-export/run.mjs",
    "proof:opa:test": "cd proofs/opa-sdk && go test -race -count=1 ./...",
    "proof:opa:run": "cd proofs/opa-sdk && go run .",
    "proof:opa:license": "node proofs/opa-sdk/license-audit.mjs",
    "proof:fargate:test": "cd proofs/fargate-verification && go test -race -count=1 ./... && node --test run.test.mjs license-audit.test.mjs",
    "proof:fargate:run": "node proofs/fargate-verification/run.mjs",
    "proof:fargate:license": "node proofs/fargate-verification/license-audit.mjs",
    "proof:fargate-egress:test": "cd proofs/fargate-egress && go test -race -count=1 ./... && node --test run.test.mjs license-audit.test.mjs",
    "proof:fargate-egress:run": "node proofs/fargate-egress/run.mjs",
    "proof:fargate-egress:license": "node proofs/fargate-egress/license-audit.mjs",
    "proof:nango:test": "node --test proofs/nango-free-boot/*.test.mjs",
    "proof:nango:run": "node proofs/nango-free-boot/run.mjs",
    "proof:nango:oauth:test": "node --test proofs/nango-oauth/*.test.mjs",
    "proof:nango:oauth:run": "node proofs/nango-oauth/run.mjs",
    "proof:nango:api-key:test": "node --test proofs/nango-api-key/*.test.mjs",
    "proof:nango:api-key:run": "node proofs/nango-api-key/run.mjs",
    "proof:nango:proxy:test": "node --test proofs/nango-proxy/*.test.mjs",
    "proof:nango:proxy:run": "node proofs/nango-proxy/run.mjs",
    "proof:promptfoo:test": "node --test proofs/promptfoo-redteam/*.test.mjs",
    "proof:promptfoo:run": "node proofs/promptfoo-redteam/run.mjs",
    "proof:promptfoo:license": "node proofs/promptfoo-redteam/license-audit.mjs",
    "proof:posthog:test": "node --test proofs/posthog-privacy/*.test.mjs",
    "proof:posthog:run": "node proofs/posthog-privacy/run.mjs",
    "proof:openrouter:test": "node --test proofs/openrouter-privacy/*.test.mjs",
    "proof:openrouter:run": "node proofs/openrouter-privacy/run.mjs",
    "proof:planner:test": "node --test proofs/security-agent-planner/*.test.mjs",
    "proof:planner:run": "node proofs/security-agent-planner/run.mjs",
    "proof:tetragon:test": "node --test proofs/tetragon-signal/*.test.mjs",
    "proof:tetragon:run": "node proofs/tetragon-signal/run.mjs",
    "proof:aws:iam:test": "cd proofs/aws-cross-account-iam && go test -race -count=1 ./... && node --test run.test.mjs",
    "proof:aws:iam:run": "node --env-file=.env proofs/aws-cross-account-iam/run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "npm run dependencies:check && npm test && npm run typecheck && npm run lint && npm run build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stytch": "14.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "js-yaml": "4.1.1",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
