        {"apiVersion": "v1", "kind": "Namespace", "metadata": {"uid": "ns-agents", "name": "agents"}},
        {"apiVersion": "v1", "kind": "Namespace", "metadata": {"uid": "ns-tools", "name": "tools"}},
