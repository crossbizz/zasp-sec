      ]},
      {"path": "/apis/rbac.authorization.k8s.io/v1/roles", "paging": "kubernetes", "envelope": {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "RoleList"}, "items": [
        {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "Role", "metadata": {"uid": "role-prod-order-writer", "name": "order-writer", "namespace": "prod"}, "rules": [{"apiGroups": [""], "resources": ["configmaps"], "verbs": ["get", "list", "update"]}]}
      ]},
      {"path": "/apis/rbac.authorization.k8s.io/v1/clusterroles", "paging": "kubernetes", "envelope": {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "ClusterRoleList"}, "items": [
        {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "ClusterRole", "metadata": {"uid": "clusterrole-cluster-admin", "name": "cluster-admin"}, "rules": [{"apiGroups": ["*"], "resources": ["*"], "verbs": ["*"]}]}
      ]},
      {"path": "/apis/rbac.authorization.k8s.io/v1/rolebindings", "paging": "kubernetes", "envelope": {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "RoleBindingList"}, "items": [
        {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "RoleBinding", "metadata": {"uid": "rb-prod-checkout-order-writer", "name": "checkout-order-writer", "namespace": "prod"}, "roleRef": {"apiGroup": "rbac.authorization.k8s.io", "kind": "Role", "name": "order-writer"}, "subjects": [{"kind": "ServiceAccount", "name": "checkout-agent", "namespace": "prod"}]}
      ]},
      {"path": "/apis/rbac.authorization.k8s.io/v1/clusterrolebindings", "paging": "kubernetes", "envelope": {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "ClusterRoleBindingList"}, "items": [
        {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "ClusterRoleBinding", "metadata": {"uid": "crb-agents-cluster-admin", "name": "agents-cluster-admin"}, "roleRef": {"apiGroup": "rbac.authorization.k8s.io", "kind": "ClusterRole", "name": "cluster-admin"}, "subjects": [{"kind": "ServiceAccount", "name": "default", "namespace": "agents"}]}
      ]},
