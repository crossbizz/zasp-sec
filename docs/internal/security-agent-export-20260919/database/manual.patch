+   d:=replace(d,'run.run_id,run.trigger_id)) ORDER BY','run.run_id,run.trigger_id))||public.zasp_sa_manual_fields(organization_value,workspace_value,environment_value,run.run_id) ORDER BY');
+  ELSE
