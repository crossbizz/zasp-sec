+DO $manual_cancellation$
+DECLARE p record;d text;scope_value text;rowname text;anchor text;
+BEGIN
+ FOR p IN SELECT oid,proname FROM pg_proc WHERE pronamespace='public'::regnamespace AND proname IN('zasp_security_agent_cancel_run','zasp_sa_attack_lab_cancel_parent') LOOP
