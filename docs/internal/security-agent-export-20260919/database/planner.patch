+  d:=replace(d,'public.zasp_security_agent_principal_ready(','public.zasp_sa_export_principal_ready(');
+  d:=replace(d,'public.'||oldprefix||'readiness(
+  (SELECT value FROM public.zasp_schema_metadata WHERE key=''production_security_agent_existing_tests_checksum''),
+  (SELECT value FROM public.zasp_schema_metadata WHERE key=''production_security_agent_existing_tests_fingerprint''))','public.zasp_sa_export_guard()');
