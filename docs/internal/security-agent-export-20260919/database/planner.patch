+-- Keep the registered budget/savepoint/receipt protocol byte-for-byte except
+-- for the closed export candidate and calls to the selection-aware context.
+DO $planner_clones$
+DECLARE p record;d text;name_value text;callee text;anchor text;names text[]:=ARRAY['reserve_core','reserve_planner','finish_prepare','accept_planner','fail_planner'];oldprefix text:='zasp_production_security_agent_existing_tests_';newprefix text:='zasp_sa_export_';
