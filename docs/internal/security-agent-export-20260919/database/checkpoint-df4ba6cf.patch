+func TestSecurityAgentExportCancelRacePostgres(t *testing.T) {
+	runExportDBFixture(t, func(f *exportDBFixture) {
+		tx, err := f.owner.Begin(f.ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
