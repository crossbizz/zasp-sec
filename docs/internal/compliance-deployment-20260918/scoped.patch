+            - { name: ZASP_COMPLIANCE_EXPORT_ROLE_ARN, value: {{ $worker.role | quote }} }
+            - { name: ZASP_COMPLIANCE_EXPORT_WEB_IDENTITY_TOKEN_FILE, value: "/var/run/secrets/eks.amazonaws.com/serviceaccount/token" }
