+							Value     string `json:"value"`
+							ValueFrom *struct {
+								FieldRef struct {
+									FieldPath string `json:"fieldPath"`
+								} `json:"fieldRef"`
+							} `json:"valueFrom"`
+						} `json:"env"`
+					} `json:"containers"`
