+// Opt in only inside the owned Linux PostgreSQL fixture, with the actual CLI
+// pre-built offline and mounted at this path. Never consume an ambient DSN.
+func TestComplianceRegistrationBinaryOwnedPostgres(t *testing.T) {
+	if runtime.GOOS != "linux" || os.Getenv("ZASP_COMPLIANCE_REGISTRATION_BINARY") != "/compliance-migrate" {
+		t.Skip("requires owned Linux PostgreSQL fixture and mounted migration CLI")
+	}
+	dsn := startMigrationPostgres(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 180*time.Second)
+	defer cancel()
+	owner := connectMigrationPostgres(t, ctx, dsn)
+	defer owner.Close(context.Background())
+	seed := func(statement string, args ...any) {
+		t.Helper()
+		if _, err := owner.Exec(ctx, statement, args...); err != nil {
+			t.Fatalf("owned fixture setup: %v", err)
+		}
+	}
+	seed(`CREATE ROLE fixture_admin LOGIN SUPERUSER; CREATE ROLE compliance_migrator LOGIN INHERIT SUPERUSER; CREATE ROLE compliance_executor LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS; CREATE ROLE compliance_cleanup LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS; CREATE ROLE compliance_other LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS`)
+	adminConfig := owner.Config().Copy()
+	adminConfig.User = "fixture_admin"
+	admin, err := pgx.ConnectConfig(ctx, adminConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Close(context.Background())
+	base := []string{"ZASP_MIGRATION_TIMEOUT=45s"}
+	forward := append([]string{}, base...)
+	forward = append(forward, "ZASP_MIGRATION_DB_PRINCIPAL=compliance_migrator")
+	for index, key := range []string{
+		discoveryAPIPrincipalEnvironment, discoveryWorkerPrincipalEnvironment, runtimeIngestPrincipalEnvironment,
+		runtimeWorkerPrincipalEnvironment, outboxWorkerPrincipalEnvironment, runtimeGatewayPrincipalEnvironment,
+		discoverySchedulerPrincipalEnvironment, projectionRiskPrincipalEnvironment, projectionGraphPrincipalEnvironment,
+		projectionSearchPrincipalEnvironment, runtimeCoordinatorPrincipalEnvironment, runtimeArchivePrincipalEnvironment,
+		runtimeIndexPrincipalEnvironment, runtimeCorrelationPrincipalEnvironment, runtimeProjectionPrincipalEnvironment,
+		gatewayControlPrincipalEnvironment, securityAgentAPIPrincipalEnvironment, securityAgentWorkerPrincipalEnvironment,
+		securityAgentActionPrincipalEnvironment, redTeamWorkerPrincipalEnvironment, redTeamOutboxPrincipalEnvironment,
+		redTeamAdapterPrincipalEnvironment, attackLabControllerPrincipalEnvironment, attackLabOutboxPrincipalEnvironment,
+		attackLabProxyPrincipalEnvironment, recoveryWorkerPrincipalEnvironment, recoveryOutboxPrincipalEnvironment,
+		policyDeploymentPrincipalEnvironment,
+	} {
+		name := fmt.Sprintf("compliance_prior_%02d", index)
+		seed(`CREATE ROLE ` + pgx.Identifier{name}.Sanitize() + ` LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS`)
+		forward = append(forward, key+"="+name)
+	}
+	run := func(label string, args, environment []string, selectedDSN, want string) {
+		t.Helper()
+		bounded, stop := context.WithTimeout(ctx, 50*time.Second)
+		defer stop()
+		command := exec.Command("/compliance-migrate", args...)
+		command.Env = append(append([]string{}, environment...), "ZASP_POSTGRES_DSN="+selectedDSN)
+		output, err := testprocess.Run(bounded, command)
+		if bounded.Err() != nil || (err == nil) != (want == "") || (want != "" && !strings.Contains(string(output), want)) || (want == "" && len(output) != 0) {
+			t.Fatalf("%s: CLI result=%v output=%q", label, err, output)
+		}
+		for _, secret := range []string{selectedDSN, "compliance_executor", "compliance_cleanup", "compliance_other", "private_marker", "SQLSTATE"} {
+			if strings.Contains(string(output), secret) {
+				t.Fatalf("%s: public output disclosed private input", label)
+			}
+		}
+		t.Log("actual CLI:", label)
+	}
+	registration := func(executor, cleanup string) []string {
+		return append(append([]string{}, base...), "ZASP_COMPLIANCE_WORKER_DB_PRINCIPAL="+executor, "ZASP_COMPLIANCE_CLEANUP_DB_PRINCIPAL="+cleanup)
+	}
+	args := []string{"register-compliance-workers"}
+	settings := registration("compliance_executor", "compliance_cleanup")
+	dsn = strings.Replace(dsn, "zasp_test@", "compliance_migrator@", 1)
+	owner = connectMigrationPostgres(t, ctx, dsn)
+	defer owner.Close(context.Background())
+	run("bootstrap exact56 through published migration command", []string{"up-to-56"}, forward, dsn, "")
+	var count int
+	if err := owner.QueryRow(ctx, `SELECT count(*) FROM zasp_compliance_worker_bindings`).Scan(&count); err != nil || count != 0 {
+		t.Fatal("forward migration registered compliance workers implicitly", count, err)
+	}
+	// The registered migration login owns the release objects. Remove all
+	// superuser/role-creation powers before any compliance registration attempt.
+	if _, err := admin.Exec(ctx, `ALTER ROLE compliance_migrator NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS`); err != nil {
+		t.Fatalf("fixture role demotion: %#v", err)
+	}
+	var authority bool
+	if err := owner.QueryRow(ctx, `SELECT session_user='compliance_migrator' AND r.rolcanlogin AND r.rolinherit AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole AND NOT r.rolreplication AND NOT r.rolbypassrls AND pg_has_role(session_user,'zasp_discovery_authority','MEMBER') AND EXISTS(SELECT 1 FROM zasp_discovery_principal_bindings WHERE principal_name=session_user AND authority_role='zasp_discovery_authority') FROM pg_roles r WHERE r.rolname=session_user`).Scan(&authority); err != nil || !authority {
+		t.Fatal("registration fixture is not registered non-superuser authority", err)
+	}
+	t.Log("registered migration session verified: LOGIN INHERIT, NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS")
+	snapshot := func() string {
+		t.Helper()
+		var value string
+		if err := admin.QueryRow(ctx, `SELECT jsonb_build_object('bindings',(SELECT COALESCE(jsonb_agg(to_jsonb(b) ORDER BY principal_name),'[]') FROM zasp_compliance_worker_bindings b),'members',(SELECT COALESCE(jsonb_agg(to_jsonb(m) ORDER BY roleid,member,grantor),'[]') FROM pg_auth_members m),'versions',(SELECT jsonb_agg(to_jsonb(v) ORDER BY version) FROM zasp_schema_versions v),'metadata',(SELECT jsonb_agg(to_jsonb(m) ORDER BY key) FROM zasp_schema_metadata m))::text`).Scan(&value); err != nil {
+			t.Fatal(err)
+		}
+		return value
+	}
+	unchanged := func(before string) {
+		t.Helper()
+		if after := snapshot(); after != before {
+			t.Fatal("refusal/replay changed bindings, grants or release state")
+		}
+	}
+	before := snapshot()
+	run("missing second SQL login rolls back first grant", args, registration("compliance_executor", "missing_cleanup"), dsn, "release migration failed")
+	unchanged(before)
+	// A valid but already cross-authority login must not acquire the worker role.
+	run("cross-authority principal rejected", args, registration("compliance_prior_00", "compliance_cleanup"), dsn, "release migration failed")
+	unchanged(before)
+	run("explicit non-superuser worker registration", args, settings, dsn, "")
+	var exact bool
+	if err := admin.QueryRow(ctx, `SELECT (SELECT count(*)=2 AND bool_and((principal_name='compliance_executor' AND authority_role='zasp_compliance_worker') OR (principal_name='compliance_cleanup' AND authority_role='zasp_compliance_cleanup')) FROM zasp_compliance_worker_bindings) AND (SELECT count(*)=2 AND bool_and(NOT m.admin_option AND m.inherit_option AND NOT m.set_option AND ((p.rolname='compliance_executor' AND r.rolname='zasp_compliance_worker') OR (p.rolname='compliance_cleanup' AND r.rolname='zasp_compliance_cleanup'))) FROM pg_auth_members m JOIN pg_roles p ON p.oid=m.member JOIN pg_roles r ON r.oid=m.roleid WHERE p.rolname IN('compliance_executor','compliance_cleanup')) AND zasp_compliance_readiness($1,$2)`, migrations.ProductionCompliance().Checksum(), migrations.ComplianceFingerprint()).Scan(&exact); err != nil || !exact {
+		t.Fatal("wrong capability binding, membership options or compiled readiness", err)
+	}
+	t.Log("exact worker/cleanup binding and INHERIT TRUE, SET FALSE, ADMIN FALSE grants verified with compiled56 readiness")
+	registered := snapshot()
+	run("idempotent replay", args, settings, dsn, "")
+	unchanged(registered)
+	for _, tc := range []struct{ label, executor, cleanup string }{
+		{"missing-name", "", "compliance_cleanup"}, {"duplicate-names", "compliance_executor", "compliance_executor"}, {"reserved-name", "zasp_compliance_worker", "compliance_cleanup"}, {"malformed-name", "private_marker;bad", "compliance_cleanup"},
+	} {
+		run(tc.label, args, registration(tc.executor, tc.cleanup), dsn, "release migration configuration rejected")
+		unchanged(registered)
+	}
+	run("extra argument", append(append([]string{}, args...), "private_marker"), settings, dsn, "release migration configuration rejected")
+	unchanged(registered)
+	run("different existing worker cannot replace binding", args, registration("compliance_other", "compliance_cleanup"), dsn, "release migration failed")
+	unchanged(registered)
+	for _, login := range []string{"compliance_executor", "compliance_cleanup", "compliance_prior_00", "compliance_other", "fixture_admin"} {
+		config := owner.Config().Copy()
+		config.User = login
+		connection, err := pgx.ConnectConfig(ctx, config)
+		if err != nil {
+			t.Fatal(err)
+		}
+		// Test SQL authority directly too, so a refusal cannot be credited solely
+		// to the CLI's release metadata access restrictions.
+		var allowed bool
+		err = connection.QueryRow(ctx, `SELECT zasp_compliance_register_workers($1,$2,$3,$4)`, "compliance_executor", "compliance_cleanup", migrations.ProductionCompliance().Checksum(), migrations.ComplianceFingerprint()).Scan(&allowed)
+		_ = connection.Close(context.Background())
+		if err == nil {
+			t.Fatal("nonregistered identity invoked registration authority")
+		}
+		foreignDSN := strings.Replace(dsn, "compliance_migrator@", login+"@", 1)
+		run("nonregistered caller denied: "+login, args, settings, foreignDSN, "release migration failed")
+		unchanged(registered)
+	}
+	for _, drift := range []struct{ label, apply, restore string }{
+		{"wrong release checksum", `UPDATE zasp_schema_versions SET checksum=repeat('0',64) WHERE version=56`, `UPDATE zasp_schema_versions SET checksum=$1 WHERE version=56`},
+		{"unavailable compiled readiness", `UPDATE zasp_schema_metadata SET value=repeat('0',64) WHERE key='production_compliance_checksum'`, `UPDATE zasp_schema_metadata SET value=$1 WHERE key='production_compliance_checksum'`},
+	} {
+		if _, err := admin.Exec(ctx, drift.apply); err != nil {
+			t.Fatal(err)
+		}
+		drifted := snapshot()
+		run(drift.label, args, settings, dsn, "release migration failed")
+		unchanged(drifted)
+		if _, err := admin.Exec(ctx, drift.restore, migrations.ProductionCompliance().Checksum()); err != nil {
+			t.Fatal(err)
+		}
+		unchanged(registered)
+	}
+	if _, err := admin.Exec(ctx, `INSERT INTO zasp_schema_versions(version,name,checksum) VALUES(57,'unknown',repeat('0',64))`); err != nil {
+		t.Fatal(err)
+	}
+	future := snapshot()
+	run("future release refused", args, settings, dsn, "release migration failed")
+	unchanged(future)
+	if _, err := admin.Exec(ctx, `DELETE FROM zasp_schema_versions WHERE version=57`); err != nil {
+		t.Fatal(err)
+	}
+	unchanged(registered)
+	run("restored exact56 replay", args, settings, dsn, "")
+	unchanged(registered)
+}
