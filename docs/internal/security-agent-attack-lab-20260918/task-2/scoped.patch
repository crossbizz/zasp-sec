+func TestAttackLabReconcilerNextScopeStartAndCancellation(t *testing.T) {
+	b := schedulerScope(t, "992200")
+	calls := 0
+	db := &reconcileQueryFixture{call: func(ctx context.Context, q string, args ...any) (json.RawMessage, error) {
+		calls++
