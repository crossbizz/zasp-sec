+        - { maxSkew: 1, topologyKey: topology.kubernetes.io/zone, whenUnsatisfiable: DoNotSchedule, labelSelector: { matchLabels: { app.kubernetes.io/name: security-agent-attack-lab-reconciler } } }
+        - { maxSkew: 1, topologyKey: kubernetes.io/hostname, whenUnsatisfiable: ScheduleAnyway, labelSelector: { matchLabels: { app.kubernetes.io/name: security-agent-attack-lab-reconciler } } }
+      securityContext: { runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, seccompProfile: { type: RuntimeDefault } }
+      containers:
+        - name: worker
+          image: {{ $image | quote }}
+          imagePullPolicy: IfNotPresent
+          command: ["/bin/sh", "-ec"]
+          args: ['export ZASP_POSTGRES_DSN="$(cat /var/run/secrets/security-agent-attack-lab-reconciler/postgres-dsn)"; exec /app/agentsec-worker']
+          ports: [{ name: internal, containerPort: 8081 }]
+          env:
+            - { name: ZASP_WORKER_MODE, value: security-agent-attack-lab-reconciler }
+            - { name: ZASP_DATABASE_AUTHORITY, value: zasp_security_agent_attack_lab_reconciler }
+            - name: ZASP_WORKER_ID
+              valueFrom: { fieldRef: { fieldPath: metadata.name } }
+            - { name: ZASP_POLL_INTERVAL, value: "1s" }
+            - { name: ZASP_LEASE_DURATION, value: "60s" }
+            - { name: ZASP_BATCH_SIZE, value: "1" }
+            - { name: ZASP_SHUTDOWN_TIMEOUT, value: "20s" }
+            - { name: ZASP_AWS_REGION, value: {{ $region | quote }} }
+            - { name: ZASP_EVIDENCE_BUCKET, value: {{ $bucket | quote }} }
+            - { name: ZASP_EVIDENCE_BUCKET_OWNER, value: {{ $owner | quote }} }
+            - { name: ZASP_EVIDENCE_KMS_KEY_ARN, value: {{ $key | quote }} }
+            - { name: ZASP_ATTACK_LAB_RECONCILER_ROLE_ARN, value: {{ $role | quote }} }
+            - { name: ZASP_ATTACK_LAB_RECONCILER_WEB_IDENTITY_TOKEN_FILE, value: /var/run/secrets/eks.amazonaws.com/serviceaccount/token }
+          volumeMounts:
+            - { name: database, mountPath: /var/run/secrets/security-agent-attack-lab-reconciler, readOnly: true }
+            - { name: identity, mountPath: /var/run/secrets/eks.amazonaws.com/serviceaccount, readOnly: true }
+          startupProbe: { httpGet: { path: /healthz, port: internal }, failureThreshold: 30, periodSeconds: 2, timeoutSeconds: 1 }
+          readinessProbe: { httpGet: { path: /readyz, port: internal }, failureThreshold: 3, periodSeconds: 5, timeoutSeconds: 2 }
+          livenessProbe: { httpGet: { path: /healthz, port: internal }, failureThreshold: 3, periodSeconds: 10, timeoutSeconds: 2 }
+          resources: { requests: { cpu: 100m, memory: 128Mi }, limits: { cpu: "1", memory: 1Gi } }
+          securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: [ALL] }, privileged: false, readOnlyRootFilesystem: true }
+      volumes:
