+			t.Fatal(err)
+		}
+		if err := reconciler.QueryRow(ctx, settleSQL, settleArgs...).Scan(&raw); err != nil || string(raw) != first {
+			t.Fatalf("restored principal lost immutable receipt: %v", err)
