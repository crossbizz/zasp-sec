+	if err != nil {
+		return v, err
+	}
+	if err := a.kube.invoke(ctx, true); err != nil {
+		return v, err
+	}
+	if a.loseRunning {
+		a.loseRunning = false
+		return v, errors.New("running reply lost after commit")
+	}
