+ IF NOT FOUND OR action_value IS NULL THEN RAISE EXCEPTION USING ERRCODE='40001',MESSAGE='attack lab route run rejected';END IF;
+ RETURN jsonb_build_object('attack_lab',action_value='start_attack_lab');
