+		admitted["AWS_ROLE_ARN"] = role
+		admitted["AWS_WEB_IDENTITY_TOKEN_FILE"] = "/var/run/secrets/eks.amazonaws.com/serviceaccount/token"
+	}
+	return admitted
 }
