+	r := &attackLabCatalogRepository{workflowRepositoryStub: &workflowRepositoryStub{}}
+	h, err := newWorkflowHTTPHandler(r, []byte("0123456789abcdef0123456789abcdef"), time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
