+func attackLabProjectionFixture(t *testing.T, proof map[string]any) (json.RawMessage, SecurityAgentRunDetail) {
+	return actionProjectionFixture(t, "start_attack_lab", "succeeded", [2]int{}, [2]int{}, func(_, s map[string]any) {
