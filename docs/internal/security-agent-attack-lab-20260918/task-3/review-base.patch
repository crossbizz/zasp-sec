+
+// Dropping linked details hides cleanup after a stopped parent; treating a
+// verified verdict as remediation misstates what the sandbox actually proved.
+func TestSecurityAgentAttackLabPublicProjection(t *testing.T) {
+	for _, verdict := range []string{"verified", "not_reproduced", "pending_cleanup"} {
+		t.Run(verdict, func(t *testing.T) {
+			proof := attackLabPublicFixture()
+			if verdict == "not_reproduced" {
+				proof["verdict"] = verdict
+				proof["settlement"].(map[string]any)["reason"] = "attack_lab_not_reproduced_in_bounded_run"
+			}
+			if verdict == "pending_cleanup" {
+				proof["state"] = "cleanup"
+				proof["cleanup_state"] = "pending"
+				proof["cleanup_complete"] = false
+				proof["settlement"] = nil
+			}
+			raw, detail := attackLabProjectionFixture(t, proof)
+			if verdict == "pending_cleanup" {
+				detail.Run.State = "cancelled"
+			}
+			got, err := decodeSecurityAgentActionDetails(raw, detail)
+			if err != nil || len(got) != 1 {
+				t.Fatalf("linked Attack Lab projection missing: %v", err)
+			}
+			detail.ActionDetails = got
+			if !validSecurityAgentActionDetails(detail) {
+				t.Fatal("public validator rejected linked lifecycle")
+			}
+			encoded, err := json.Marshal(got)
+			if err != nil || !strings.Contains(string(encoded), `"attack_lab":`) || !strings.Contains(string(encoded), `"execution_id":"`+existingTestPublicRun+`"`) || strings.Contains(string(encoded), "remediated") {
+				t.Fatal("linked evidence lost or mislabeled")
+			}
+		})
+	}
+}
