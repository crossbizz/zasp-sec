+func TestSecurityAgentAttackLabDecisionHTTPPreservesRedactedSnapshot(t *testing.T) {
+	now := time.Now().UTC()
+	approval := SecurityAgentApproval{ID: "pid_78000001-0000-4000-8000-000000000001", RunID: "pid_78000002-0000-4000-8000-000000000002", StepID: "pid_78000003-0000-4000-8000-000000000003", State: "pending", ExpiresAt: now.Add(time.Minute), Version: 1, ExpectedEffect: "Run a bounded Attack Lab reproduction; human interpretation required", EvidenceSummary: []string{"pid_78000004-0000-4000-8000-000000000004"}, AttackLab: attackLabApprovalPrivateFixture()}
+	result := SecurityAgentApprovalResult{ID: approval.ID, RunID: approval.RunID, StepID: approval.StepID, State: "approved", ExpiresAt: approval.ExpiresAt, Version: 2, ExpectedEffect: approval.ExpectedEffect, EvidenceSummary: approval.EvidenceSummary, AttackLab: approval.AttackLab, AuditID: "pid_78000005-0000-4000-8000-000000000005", CorrelationID: testCorrelationID, ReceiptID: "pid_78000007-0000-4000-8000-000000000007"}
+	stub := &securityAgentPublicAuthorityStub{approval: approval, decided: result}
+	ids := []string{result.AuditID, result.ReceiptID}
+	h, err := NewSecurityAgentPublicHTTPHandler(stub, http.NotFoundHandler(), SecurityAgentPublicHandlerConfig{Clock: func() time.Time { return now }, SigningKey: securityAgentTestSigningKey, NewProductID: func() (string, error) { id := ids[0]; ids = ids[1:]; return id, nil }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	identity := fixtureRequestIdentity(t)
+	identity.FreshAuthenticated = true
+	identity.FreshAuthExpiresAt = now.Add(time.Minute)
+	r := workflowRequest(t, identity, testCorrelationID, "decideSecurityAgentApproval", map[string]string{"id": approval.ID}, http.MethodPost, "/api/v1/security-agent-approvals/"+approval.ID+"/decision", `{"decision":"approved"}`)
+	r.Header.Set("Idempotency-Key", "attack-decision-response-0001")
+	r.Header.Set("If-Match", `"1"`)
+	r.Header.Set("X-Zasp-Fresh-Auth", "confirmed")
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code != 200 {
+		t.Fatalf("decision status %d: %s", w.Code, w.Body.String())
+	}
+	var body map[string]json.RawMessage
+	if json.Unmarshal(w.Body.Bytes(), &body) != nil || len(body["attack_lab"]) == 0 {
+		t.Fatalf("decision lost committed approval context: %s", w.Body.String())
+	}
+	if strings.Contains(w.Body.String(), "private-") || strings.Contains(w.Body.String(), "source_evidence") || !strings.Contains(w.Body.String(), `"destination":"canary.example.test"`) {
+		t.Fatal("decision snapshot is not safely redacted")
+	}
