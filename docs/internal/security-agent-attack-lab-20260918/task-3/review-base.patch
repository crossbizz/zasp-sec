+func TestSecurityAgentAttackLabPublicRejectsContradictions(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		mutate func(map[string]any)
+	}{
+		{"private storage", func(p map[string]any) { p["key"] = "private-sentinel" }},
+		{"wrong definition", func(p map[string]any) { p["definition_id"] = existingTestPublicBefore }},
+		{"wrong version", func(p map[string]any) { p["definition_version"] = 2 }},
+		{"remediation", func(p map[string]any) { p["settlement"].(map[string]any)["outcome"] = "remediated" }},
+		{"wrong verdict", func(p map[string]any) { p["verdict"] = "not_reproduced" }},
+		{"cleanup incomplete", func(p map[string]any) { p["cleanup_complete"] = false }},
+		{"wrong proof", func(p map[string]any) {
+			p["settlement"].(map[string]any)["proof_digest"] = "sha256:" + strings.Repeat("d", 64)
+		}},
+		{"null attempt", func(p map[string]any) { p["attempt"] = nil }},
+		{"missing evidence", func(p map[string]any) { p["evidence"] = nil }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p := attackLabPublicFixture()
+			tc.mutate(p)
+			raw, detail := attackLabProjectionFixture(t, p)
+			if got, err := decodeSecurityAgentActionDetails(raw, detail); err == nil || got != nil {
+				t.Fatal("contradictory Attack Lab detail accepted")
+			}
+		})
+	}
+}
