+func attackLabPublicFixture() map[string]any {
+	return map[string]any{"definition_id": existingTestPublicDefinition, "definition_version": 1, "source_run_id": existingTestPublicBefore, "source_attempt": 1, "execution_id": existingTestPublicRun, "attempt": 1, "state": "complete", "verdict": "verified", "cleanup_state": "complete", "cleanup_complete": true, "cancel_requested": false, "evidence": map[string]any{"reference_digest": strings.Repeat("a", 64), "version_id": "immutable-version", "sha256": strings.Repeat("b", 64), "size_bytes": 128}, "settlement": map[string]any{"outcome": "needs_human", "reason": "attack_lab_unsafe_condition_reproduced", "proof_digest": "sha256:" + strings.Repeat("c", 64)}}
