#!/usr/bin/env bash
# zasp: one entry point to install, run and operate Zasp.
#
#   ./zasp doctor                 check prerequisites and configuration
#   ./zasp secrets init           generate keys; list what a person must supply
#   ./zasp up                     install, create the first administrator, start
#   ./zasp demo seed --email <address>   fill a demo environment with sample data
#   ./zasp status | logs | stop | start | upgrade | backup | restore | uninstall
#
# The profile (vps, local, kubernetes or aws) and every setting come from one
# configuration file, zasp.env in the repository root (see
# deploy/zasp/zasp.env.example). Guide: docs/getting-started/administrator.md.
#
# Written for bash 3.2 (the macOS system bash) as well as current bash.
set -euo pipefail

ZASP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZASP_LIB="$ZASP_ROOT/deploy/zasp/lib"
# shellcheck source=deploy/zasp/lib/common.sh
. "$ZASP_LIB/common.sh"

usage() {
  cat <<'EOF'
usage: zasp [--profile vps|local|kubernetes|aws] [--config <file>] [--dry-run] <command> [arguments]

Getting started
  doctor                  Check prerequisites and configuration; print exactly what is missing.
  config init             Write a configuration file (zasp.env) with safe defaults.
  secrets init            Initialize the selected profile. On VPS, use secrets init openbao.
  secrets unseal openbao  Resume a sealed, independently managed VPS OpenBao instance.
  install                 Install the selected profile. On VPS, select dependencies, openbao, or nango.
  bootstrap-admin         Create the first organization and invite its first administrator.
  up                      install, bootstrap-admin (when configured) and start, in one command.

Evaluating
  demo seed --email <address>   Fill an environment of its own with sample agents, findings and MCP servers
                          for this person. Run it again to refresh. Options: zasp demo help.
  demo status             List the scopes that hold demo data.
  demo remove             Delete the demo data and the scopes created for it (needs --yes).

Operating
  nango dashboard         Open a loopback tunnel to this Kubernetes release's private Nango dashboard.
  start                   Start the product.
  stop                    Stop the product and its dependencies. Data is kept.
  status                  One line per dependency and process.
  logs [name] [--follow]  Show logs; without a name, list what has logs.
  upgrade                 Rebuild or roll out the current checkout and restart.
  backup [file]           Write the profile archive, encrypted archive, or offsite receipt.
  backup upload <archive> <file>   Encrypt an existing file and save an archive or receipt.
  backup download <file> <output>  Verify and decrypt a backup into a new private file.
  restore <file> --yes    Restore the selected profile from an archive or receipt.
  uninstall --yes         Remove the selected application deployment. VPS shared services have separate lifecycles.

Options
  --profile <name>   vps (independent components), local, kubernetes (evaluation), or aws (production).
                     New configs default to vps. Existing installs use their selected profile.
  --config <file>    Configuration file. Default: $ZASP_CONFIG, else zasp.env in the repository root.
  --dry-run          Preview the selected VPS operation without changing the host or cluster.
  --yes              Confirm a destructive command.

VPS first deployment: docs/operations/vps-first-deployment.md
Guide: docs/getting-started/administrator.md
EOF
}

ZASP_DRY_RUN=0
ZASP_YES=0
profile_option=""
config_option=""
arguments=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile) [ "$#" -ge 2 ] || die "--profile needs a value"; profile_option="$2"; shift 2 ;;
    --profile=*) profile_option="${1#--profile=}"; shift ;;
    --config) [ "$#" -ge 2 ] || die "--config needs a value"; config_option="$2"; shift 2 ;;
    --config=*) config_option="${1#--config=}"; shift ;;
    --dry-run) ZASP_DRY_RUN=1; shift ;;
    --yes) ZASP_YES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) arguments+=("$1"); shift ;;
  esac
done
if [ "${#arguments[@]}" -eq 0 ]; then
  usage >&2
  exit 2
fi
command_name="${arguments[0]}"
rest=()
if [ "${#arguments[@]}" -gt 1 ]; then rest=("${arguments[@]:1}"); fi

ZASP_CONFIG_FILE="${config_option:-${ZASP_CONFIG:-$ZASP_ROOT/zasp.env}}"
if [ "$command_name" = help ]; then usage; exit 0; fi
if [ "$command_name" = config ]; then
  [ "${#rest[@]}" -eq 1 ] && [ "${rest[0]:-}" = init ] || die "usage: zasp config init"
  config_init "${profile_option:-${ZASP_PROFILE:-vps}}"
  exit 0
fi

load_config "$ZASP_CONFIG_FILE"
ZASP_PROFILE="${profile_option:-${ZASP_PROFILE:-}}"
if [ -z "$ZASP_PROFILE" ]; then
  if [ "$ZASP_CONFIG_PRESENT" = 1 ]; then
    die "profile is ambiguous; set ZASP_PROFILE in this configuration or pass --profile explicitly"
  fi
  case "$command_name" in
    doctor|status|logs) ZASP_PROFILE=vps ;;
    *) die "no selected installation; run ./zasp config init or select an existing configuration and profile" ;;
  esac
fi
case "$ZASP_PROFILE" in
  vps|local|kubernetes|aws) ;;
  *) die "unknown profile '$ZASP_PROFILE' (vps, local, kubernetes or aws)" ;;
esac
case "$command_name" in
  stop|restore|uninstall|upgrade|backup)
    [ -z "$ZASP_FILE_PROFILE" ] || [ "$ZASP_PROFILE" = "$ZASP_FILE_PROFILE" ] ||
      die "selected profile conflicts with the installation in the configuration; choose the matching config file"
    ;;
esac
export ZASP_PROFILE ZASP_DRY_RUN ZASP_YES
# shellcheck source=/dev/null
. "$ZASP_LIB/$ZASP_PROFILE.sh"

case "$command_name" in
  doctor|install|up|start|stop|status|logs|upgrade|backup|restore|uninstall) ;;
  nango) [ "$ZASP_PROFILE" = kubernetes ] || die "nango dashboard uses the kubernetes profile" ;;
  bootstrap-admin) command_name=bootstrap_admin ;;
  demo)
    [ "${#rest[@]}" -ge 1 ] || die "usage: zasp demo seed --email <address> | status | remove --yes | help"
    case "${rest[0]}" in
      seed|status|help) ;;
      remove)
        # --yes is an option of zasp itself; pass it on.
        [ "$ZASP_YES" = "0" ] || rest+=(--yes)
        ;;
      *) die "usage: zasp demo seed --email <address> | status | remove --yes | help" ;;
    esac
    ;;
  secrets)
    case "${rest[0]:-}" in
      init) command_name=secrets_init ;;
      unseal) [ "$ZASP_PROFILE" = vps ] || die "unseal requires the vps profile"; command_name=secrets_unseal ;;
      *) die "usage: zasp secrets init | zasp secrets unseal openbao" ;;
    esac
    rest=("${rest[@]:1}")
    if [ "$ZASP_PROFILE" != vps ] && [ "${#rest[@]}" -ne 0 ]; then die "usage: zasp secrets init"; fi
    ;;
  *) usage >&2; die "unknown command '$command_name'" ;;
esac
if [ "$ZASP_PROFILE" = vps ]; then
  vps_validate_providers
  if [ "$ZASP_DRY_RUN" = 1 ]; then export PYTHONDONTWRITEBYTECODE=1; fi
fi
if [ "$command_name" = backup ] || [ "$command_name" = restore ]; then
  case "${ZASP_BACKUP_PROVIDER-local}" in
    local|s3|r2) ;;
    *) die 'ZASP_BACKUP_PROVIDER must be local, s3 or r2' ;;
  esac
  if [ "$ZASP_PROFILE" = vps ] || [ "${ZASP_BACKUP_PROVIDER:-local}" != local ] || [ -n "${ZASP_BACKUP_RECIPIENT_FILE:-}${ZASP_BACKUP_IDENTITY_FILE:-}" ] ||
     { [ "$command_name" = backup ] && { [ "${rest[0]:-}" = upload ] || [ "${rest[0]:-}" = download ]; }; }; then
    require_tool python3
    # Bash 3.2 with nounset cannot expand an empty array directly.
    exec python3 "$ZASP_LIB/backup.py" "$ZASP_ROOT" "$ZASP_CONFIG_FILE" "$command_name" ${rest[@]+"${rest[@]}"}
  fi
fi
if [ "$ZASP_PROFILE" = vps ]; then
  vps_dispatch "$command_name" ${rest[@]+"${rest[@]}"}
  exit
fi
if [ "${#rest[@]}" -gt 0 ]; then
  "${ZASP_PROFILE}_${command_name}" "${rest[@]}"
else
  "${ZASP_PROFILE}_${command_name}"
fi
